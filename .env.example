# Realsecrets Environment Configuration
# Target: Supabase Free Tier (₹0 initial cost) + Vercel Hobby

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous Public Key (safe to expose in client bundle)
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_ANON_KEY=

# Shared Secret Access Code (Default prototype: bepositive)
# Note: For production, this shared secret is also used to derive the client-side AES-256-GCM encryption key.
VITE_SECRET_CODE=bepositive
